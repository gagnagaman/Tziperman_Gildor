#

#
# ---------------------------------------------------------------
#   specify path to directory
# ---------------------------------------------------------------
#
set filepath = $pwdirct/program
set workpath = $pwdirct/work


if ( -d $workpath ) then
  cp -p $filepath/*.f $workpath/.
  cp -p $filepath/*.h $workpath/.
  cp -p $filepath/Makefile $workpath/.
  cp -p $filepath/insolation.input $workpath/.  
  cd $workpath 
else
  mkdir $workpath 
  cp -p $filepath/*.f $workpath/.
  cp -p $filepath/*.h $workpath/.
  cp -p $filepath/Makefile $workpath/.
  cp -p $filepath/insolation.input $workpath/.  
